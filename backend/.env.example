# Free OpenAI-compatible provider (Groq / OpenRouter / etc.)
OPENAI_API_KEY=gsk_YOUR_GROQ_API_KEY
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Vision provider for camera input (OpenRouter recommended - free tier available)
# Sign up at https://openrouter.ai/keys
VISION_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY
VISION_BASE_URL=https://openrouter.ai/api/v1

# Supabase — Project settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# Google Gemini (image generation + optional vision)
# Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare Workers AI (fallback image gen)
# ACCOUNT_ID: Cloudflare dashboard -> Workers & Pages -> right sidebar
# API_TOKEN: My Profile -> API Tokens -> Create Token (Workers AI template)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# OpenCode Zen (final fallback free models)
# Get key from https://opencode.ai/auth
ZEN_API_KEY=sk-YOUR_ZEN_KEY
ZEN_BASE_URL=https://opencode.ai/zen/v1

# Text models (Groq free)
MODEL_ID=llama-3.3-70b-versatile
MODEL_FALLBACKS=llama-3.1-8b-instant,openai/gpt-oss-120b,openai/gpt-oss-20b,groq/compound

# Vision models (OpenRouter - used when ingredient photo provided)
VISION_MODEL_ID=google/gemini-2.5-flash-image
VISION_MODEL_FALLBACKS=google/gemini-3.1-flash-image,google/gemini-3-pro-image

# Optional overrides
TTS_VOICE=en-US-JennyNeural
XP_PER_COMPLETION=50
CORS_ORIGINS=*
